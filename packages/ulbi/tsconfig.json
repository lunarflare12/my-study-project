{
  "extends": "../../config/tslint-config/tsconfig.react.json",
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "*": ["./src/*"],
      "@config/webpack-config": ["../../config/webpack-config/build_config/index.ts"],
      "@config/webpack-config/types": ["../../config/webpack-config/types/types.ts"],
      "@config/stylelint-config": ["../../config/stylelint-config/src/index.ts"],
      "@config/eslint-config": ["../../config/eslint-config/src/index.ts"]
    }
  },
  "include": ["src", "webpack.config.ts", "stylelint.config.ts", "eslint.config.js"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "esModuleInterop": true
    },
    "esm": false,
    "transpileOnly": true,
    "files": true,
    "experimentalSpecifierResolution": "node"
  }
}
